PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shoping-mall

# Auth — use long random strings in production (never commit real values)
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Token lifetime
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing (bcrypt cost factor, 10–12 typical)
BCRYPT_SALT_ROUNDS=10

# CORS — 프론트/백 분리 시 필수 (쉼표 구분)
# CORS_ORIGINS=http://localhost:5173,https://www.your-domain.com

# HTTPS 리버스 프록시(Nginx, Render 등) 뒤에서 1
# TRUST_PROXY=1

# 프로덕션: client/dist 경로 (기본: ../client/dist)
# CLIENT_DIST=/var/www/shoping-mall/client/dist
# SERVE_CLIENT=1

# 세션 쿠키 (HTTPS 프로덕션)
# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_DOMAIN=.your-domain.com
# SESSION_COOKIE_SAMESITE=lax

# PortOne REST API (결제 단건 조회·검증) — https://admin.portone.io/ 시스템 설정 > API Keys
PORTONE_IMP_KEY=imp_apikey_placeholder
PORTONE_IMP_SECRET=imp_secret_placeholder

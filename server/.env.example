# 로컬: 이 파일을 server/.env 로 복사 후 값 입력
# Railway: 대시보드 Variables에 동일 키 추가 (.env 업로드 금지)
# 가이드: docs/RAILWAY.md

# --- Railway: PORT는 자동 주입, 5000 고정하지 말 것 ---
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# --- 필수 (Railway production) ---
MONGODB_URI=mongodb://127.0.0.1:27017/shoping-mall
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# --- Railway + Vercel 분리 배포 시 필수 ---
# CORS_ORIGINS=https://your-app.vercel.app
# TRUST_PROXY=1

# --- Token / bcrypt (선택, 기본값 있음) ---
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- 세션 쿠키 (Vercel+Railway: CORS_ORIGINS 설정 시 sameSite none 자동) ---
# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_DOMAIN=

# --- PortOne REST (주문 결제 서버 검증) ---
PORTONE_IMP_KEY=imp_apikey_placeholder
PORTONE_IMP_SECRET=imp_secret_placeholder

# --- 단일 서버 배포만 (Vercel 사용 시 넣지 않음) ---
# CLIENT_DIST=
# SERVE_CLIENT=

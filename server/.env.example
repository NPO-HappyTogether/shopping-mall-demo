# 로컬: server/.env.example → server/.env 복사 후 값 입력
# Railway: 아래 키를 Variables에 동일 이름으로 추가 (.env 업로드 금지)
# 전체 목록: docs/ENV.md

PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# MongoDB — 1) MONGODB_ATLAS_URL  2) MONGODB_URI  3) 로컬 기본값
MONGODB_ATLAS_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/
# MONGODB_URI=mongodb://127.0.0.1:27017/shopping-mall-demo

JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Railway + Vercel 분리 배포
# CORS_ORIGINS=https://your-app.vercel.app
# TRUST_PROXY=1

JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=none

PORTONE_IMP_KEY=imp_apikey_placeholder
PORTONE_IMP_SECRET=imp_secret_placeholder

# Vercel 사용 시 넣지 않음: SERVE_CLIENT, CLIENT_DIST

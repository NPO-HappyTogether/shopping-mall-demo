# 로컬: client/.env.example → client/.env 복사 후 값 입력
# Vercel: Production Variables에 동일 이름 (VITE_ 접두사 필수)
# MongoDB는 server/.env 또는 Railway에만 — client에 넣지 않음
# 전체 목록: docs/ENV.md

# Vercel + Railway 분리 시 필수 (Railway Public URL, 끝 / 없음)
# VITE_API_URL=https://your-service.up.railway.app
# 로컬 Vite만 쓸 때는 비워 두세요 (프록시 → localhost:5000)

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_FOLDER=products

VITE_PORTONE_STORE_ID=store-your-store-id
VITE_PORTONE_CHANNEL_KEY=channel-key-your-channel-key
# VITE_PORTONE_REDIRECT_URL=https://your-app.vercel.app/checkout/complete

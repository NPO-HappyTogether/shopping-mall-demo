# 이 파일은 예시입니다. 값을 복사해 client/.env 에 넣으세요 (.env.example 은 Vite가 읽지 않음).
#
# API (방식 B: 프론트/백 분리 배포 시에만 설정. 같은 서버 배포면 비워 두세요)
# VITE_API_URL=https://api.your-domain.com
#
#
# Cloudinary ? https://console.cloudinary.com/
# Settings ? Account: Cloud name
# Settings ? Upload ? Upload presets: preset name (Signing Mode: Unsigned ??)
# Settings ? API Keys ? API Key (Signed preset? ??, Secret? ?? ???)

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_FOLDER=products

# PortOne V2 결제 — https://admin.portone.io/integration-v2/manage/channel
# Store ID (store-...) + 채널 키(channel-key-...) 필수. V1 PG 코드(html5_inicis)는 사용하지 않음.
VITE_PORTONE_STORE_ID=store-39337918-0aa5-4eab-8a01-5a7728538293
VITE_PORTONE_CHANNEL_KEY=channel-key-your-channel-key-here
# 모바일 결제 완료 후 리디렉션 (선택, 기본: /checkout/complete)
# VITE_PORTONE_REDIRECT_URL=http://localhost:5173/checkout/complete
